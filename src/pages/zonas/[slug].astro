---
// Página de una zona con `texto` (src/lib/paginas.ts, sección `zonas`): /zonas/<slug>/.
// Diseño «obra limpia»: banda hondo con juntas de azulejo, migas y «Reformas de baños y cocinas en <zona>»
// (`titulo_pagina` de la sección, con {zona}); el texto propio de la zona (con la foto de la zona o de la sección
// si la hay); los packs de la web (los que tienen ficha, enlazados) en banda de agua; los trabajos cuyo `lugar`
// nombra la zona; hasta tres opiniones (primero las que nombran la zona); banda verde agua de presupuesto y las
// otras zonas con página.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { enlaceDe, introZona, resumen, tituloZona, trabajosEn, zonasConPagina } from '../../lib/paginas';
import type { Zona } from '../../lib/paginas';
import { jsonLdMigas, jsonLdZona, urlBase } from '../../lib/seo';
import { enlace, rutaDeSeccion } from '../../lib/multipagina';

export function getStaticPaths() {
  return zonasConPagina().map((z) => ({ params: { slug: z.slug }, props: { z } }));
}

interface Props { z: Zona }
const { z } = Astro.props;
const base = urlBase(Astro.site);
const titulo = tituloZona(z);
const intro = introZona(z);
const nombreSeccion = String(z.seccion.antetitulo || z.seccion.titulo || 'Zonas').trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: rutaDeSeccion(z.idSeccion) },
  { nombre: z.nombre, ruta: z.url },
];
const c = site.contacto;
const foto = z.imagen || String(z.seccion.imagen || '');
const packs = seccion('packs');
const listaPacks = packs ? packs.packs.filter((it) => it?.nombre) : [];
const trabajos = trabajosEn(z.nombre).slice(0, 4);
const opinionesSec = seccion('opiniones');
const todas = opinionesSec ? opinionesSec.testimonios.filter((t) => t?.texto) : [];
const nombra = (t: { texto: string; nota?: string }) => `${t.texto} ${t.nota ?? ''}`.toLowerCase().includes(z.nombre.toLowerCase());
const opiniones = [...todas.filter(nombra), ...todas.filter((t) => !nombra(t))].slice(0, 3);
const presupuesto = seccion('presupuesto') ? enlace('/#presupuesto') : site.boton_cabecera?.url || enlace('/#contacto');
const textoPresupuesto = site.boton_cabecera?.texto || 'Pedir presupuesto';
const wa = whatsapp(c.whatsapp, `Hola, quiero presupuesto para una reforma en ${z.nombre}`);
const otras = zonasConPagina().filter((x) => x !== z);
---

<Base titulo={titulo} descripcion={resumen(z.texto[0] ?? intro)} imagen={foto} ld={[jsonLdMigas(base, migas), jsonLdZona(base, z)]}>
  <section class="banda-hondo azulejo zona-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class="zona-intro">
        <p class="antetitulo">{z.nombre}</p>
        <h1 class="titulo-seccion zona-titulo">{titulo}</h1>
        {intro && <p class="titular-texto">{intro}</p>}
        <div class="zona-botones">
          <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
          {c.telefono && <a class="btn-sec" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </div>
    </div>
  </section>

  <section class="banda-clara seccion">
    <div class:list={['contenedor zona-cuerpo', { 'zona-cuerpo--foto': foto }]}>
      <div class="texto-largo zona-texto">
        {z.texto.map((p) => <p>{p}</p>)}
      </div>
      {foto && <Imagen src={foto} alt={titulo} ancho={1000} alto={750} class="zona-foto" />}
    </div>
  </section>

  {listaPacks.length > 0 && (
    <section class="banda-agua azulejo seccion">
      <div class="contenedor">
        <Titular antetitulo={packs?.antetitulo} titulo={`Qué reformo en ${z.nombre}`} />
        <ul class="zona-packs">
          {listaPacks.map((it) => (
            <li class="zona-pack">
              <h3>{enlaceDe(it) ? <a href={enlaceDe(it)} class="zona-enlace">{it.nombre}</a> : it.nombre}</h3>
              {it.texto && <p>{it.texto}</p>}
              <p class="zona-pack-pie">
                {it.precio && <span class="zona-precio">{it.precio}</span>}
                {enlaceDe(it) && <span class="zona-ver" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {trabajos.length > 0 && (
    <section class="banda-clara seccion">
      <div class="contenedor">
        <Titular antetitulo="Trabajos hechos" titulo={`Obras en ${z.nombre}`} />
        <ul class="zona-trabajos">
          {trabajos.map((t) => (
            <li class="zona-trabajo">
              {(t.imagen || t.imagen_antes) && <Imagen src={t.imagen || t.imagen_antes} alt={t.titulo} ancho={1200} alto={675} class="aspect-[16/9] w-full object-cover" />}
              <div class="zona-trabajo-texto">
                <h3>{t.titulo}</h3>
                {t.lugar && <p class="zona-lugar"><Icono nombre="mapa" tam={16} />{t.lugar}</p>}
                {t.texto && <p class="mt-2 opacity-85">{t.texto}</p>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {opiniones.length > 0 && (
    <section class="banda-madera-suave seccion">
      <div class="contenedor">
        <Titular antetitulo={opinionesSec?.antetitulo} titulo={opinionesSec?.titulo} />
        <ul class="zona-opiniones">
          {opiniones.map((t) => (
            <li class="zona-opinion">
              <span class="zona-comilla" aria-hidden="true">“</span>
              <blockquote>{t.texto}</blockquote>
              <p class="mt-4 font-semibold">{t.autor}</p>
              {t.nota && <p class="text-sm opacity-70">{t.nota}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="banda-primario azulejo seccion">
    <div class="contenedor zona-final">
      <div>
        <p class="antetitulo">Presupuesto gratis</p>
        <h2 class="titulo-seccion">¿Reformas en {z.nombre}?</h2>
        <p class="titular-texto">Voy a verlo, mido y te dejo el precio cerrado por escrito.</p>
      </div>
      <div class="zona-botones">
        <a class="btn" href={presupuesto}>{textoPresupuesto}</a>
        {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
      </div>
    </div>
  </section>

  {otras.length > 0 && (
    <section class="banda-clara seccion">
      <div class="contenedor">
        <h2 class="zona-otras-titulo">También trabajo en</h2>
        <ul class="zona-otras">
          {otras.map((o) => <li><a class="zona-otra" href={o.url}><Icono nombre="mapa" tam={16} /> {o.nombre}</a></li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .zona-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "›"; opacity: .5; }
  .migas a { text-decoration: none; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; }
  .migas [aria-current] { opacity: .75; overflow-wrap: anywhere; }
  .zona-intro { max-width: 52rem; padding-top: clamp(1rem, 3vw, 2.5rem); }
  .zona-titulo { font-size: clamp(2.3rem, 7vw, 4.75rem); overflow-wrap: anywhere; }
  .zona-botones { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .zona-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .zona-cuerpo { display: grid; gap: 2.5rem; align-items: center; }
  .zona-texto { font-size: 1.15rem; max-width: 44rem; }
  .zona-texto p + p { margin-top: 1rem; }
  .zona-texto p:first-child { font-size: 1.25rem; }
  :global(.zona-foto) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 50vw 50vw var(--radio) var(--radio) / 7rem 7rem var(--radio) var(--radio); }
  .zona-packs { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .zona-pack { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; border-radius: var(--radio); background: var(--c-fondo); border: 1px solid var(--linea); }
  .zona-pack:hover { border-color: var(--c-primario); }
  .zona-pack h3 { font-size: 1.6rem; }
  .zona-pack p { opacity: .85; }
  .zona-enlace { text-decoration: none; }
  .zona-enlace::after { content: ""; position: absolute; inset: 0; border-radius: var(--radio); }
  .zona-enlace:focus-visible { outline: none; }
  .zona-pack:has(.zona-enlace:focus-visible) { outline: 3px solid var(--c-primario); outline-offset: 3px; }
  .zona-pack-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .zona-precio { font-family: var(--fuente-titulos); font-size: 1.5rem; line-height: 1; color: var(--c-primario); }
  .zona-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 650; color: var(--c-primario); }
  .zona-trabajos { display: grid; gap: 1.5rem; }
  .zona-trabajo { border: 1px solid var(--linea); border-radius: var(--radio); overflow: hidden; background: var(--c-fondo); }
  .zona-trabajo-texto { padding: 1.25rem 1.5rem 1.5rem; }
  .zona-trabajo h3 { font-size: 1.5rem; }
  .zona-lugar { display: inline-flex; align-items: center; gap: .4rem; margin-top: .4rem; font-size: .85rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; opacity: .75; }
  .zona-opiniones { display: grid; gap: 1rem; }
  .zona-opinion { padding: 1.5rem; border-radius: var(--radio); background: var(--c-fondo); }
  .zona-comilla { display: block; font-family: var(--fuente-titulos); font-size: 3.5rem; line-height: .8; color: var(--c-primario); }
  .zona-final { display: grid; gap: 1.5rem; align-items: center; }
  .zona-final .zona-botones { margin-top: 0; }
  .zona-otras-titulo { font-size: 1.75rem; }
  .zona-otras { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.25rem; }
  .zona-otra { display: inline-flex; align-items: center; gap: .4rem; min-height: 2.75rem; padding: .5rem 1rem; border: 1px solid var(--linea); border-radius: var(--radio); font-weight: 600; text-decoration: none; }
  .zona-otra:hover { background: var(--c-primario); color: var(--sobre-primario); border-color: var(--c-primario); }
  @media (min-width: 768px) {
    .zona-trabajos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .zona-opiniones { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .zona-cuerpo--foto { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
    .zona-final { grid-template-columns: 1.4fr 1fr; }
    .zona-final .zona-botones { justify-content: flex-end; }
  }
</style>
