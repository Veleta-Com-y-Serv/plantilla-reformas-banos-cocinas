---
// Materiales: banda de madera suave a todo el ancho. Titular centrado y `items: [{titulo, texto, imagen}]` como
// hornacinas: cada foto con la parte de arriba en medio punto (arco), título en serif y texto debajo.
// 4 columnas en escritorio, 2 en tableta y móvil. Sin foto, la hornacina queda en verde agua hondo con juntas de
// azulejo. `cta` opcional debajo. Sin elementos, solo el titular.
import { seccion } from '../../data/site';
import { altFicha } from '../../lib/seo';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const items = s ? s.items.filter((it) => it && it.titulo) : [];
---

{
  s && (
    <section id={Astro.props.id} class="seccion banda-madera-suave">
      <div class="contenedor">
        <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
        {items.length > 0 && (
          <ul class="hornacinas">
            {items.map((it) => (
              <li class="hornacina">
                <div class:list={['hornacina-foto banda-hondo', { azulejo: !it.imagen }]}>
                  {it.imagen && <Imagen src={it.imagen} alt={altFicha(it)} ancho={600} alto={800} />}
                </div>
                <h3 class="hornacina-titulo">{it.titulo}</h3>
                {it.texto && <p class="hornacina-texto">{it.texto}</p>}
              </li>
            ))}
          </ul>
        )}
        {s.cta && <p class="mt-12 text-center"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
      </div>
    </section>
  )
}

<style>
  .hornacinas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.25rem 1rem; }
  .hornacina-foto { position: relative; overflow: hidden; aspect-ratio: 3 / 4; border-radius: 999px 999px var(--radio) var(--radio); box-shadow: 0 0 0 6px var(--c-fondo), 0 0 0 7px color-mix(in srgb, var(--c-acento) 60%, transparent); }
  .hornacina-foto :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hornacina-titulo { margin-top: 1.4rem; font-size: clamp(1.3rem, 2vw, 1.75rem); text-align: center; }
  .hornacina-texto { margin-top: .4rem; font-size: .95rem; opacity: .82; text-align: center; }
  @media (min-width: 768px) { .hornacinas { gap: 3rem 2rem; } }
  @media (min-width: 1100px) { .hornacinas { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3rem 2.75rem; } }
</style>
