---
// Preguntas frecuentes: banda clara partida. A la izquierda (fija al bajar, desde 1024 px) el titular, el teléfono
// en serif y el WhatsApp; a la derecha, acordeón nativo <details> con filetes y un «+» en una pieza de azulejo
// que gira al abrirse. Sin JavaScript. Campos: `preguntas[]` (pregunta, respuesta). Sin preguntas no se pinta.
// Diseño para apartados nuevos (`tipo: preguntas`).
import { seccion, site, tel, whatsapp } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
const c = site.contacto;
---

{
  s && preguntas.length > 0 && (
    <section id={Astro.props.id} class="seccion banda-clara">
      <div class="contenedor faq-rejilla">
        <div class="faq-lado">
          <Titular class="!mb-6" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
          {c.telefono && <a class="faq-tel" href={tel(c.telefono)}>{c.telefono}</a>}
          {c.whatsapp && (
            <p>
              <a class="enlace-subrayado gap-2" href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">
                <Icono nombre="whatsapp" tam={18} />
                O escríbeme por WhatsApp
              </a>
            </p>
          )}
        </div>
        <div class="faq-lista">
          {preguntas.map((p) => (
            <details class="faq">
              <summary>
                <span>{p.pregunta}</span>
                <span class="faq-signo" aria-hidden="true">+</span>
              </summary>
              {p.respuesta && <p class="faq-respuesta">{p.respuesta}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq-rejilla { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .faq-rejilla { grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr); gap: 5rem; align-items: start; }
    .faq-lado { position: sticky; top: calc(var(--alto-cabecera) + 2rem); }
  }
  .faq-tel { display: inline-block; font-family: var(--fuente-titulos); font-size: clamp(2rem, 3.6vw, 2.8rem); letter-spacing: -0.015em; text-decoration: none; color: var(--c-primario); }
  .faq-lista { border-top: 1px solid var(--linea); }
  .faq { border-bottom: 1px solid var(--linea); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.25rem; padding: 1.35rem 0; min-height: 3rem; font-family: var(--fuente-titulos); font-size: clamp(1.2rem, 1.9vw, 1.5rem); line-height: 1.25; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--c-primario); }
  .faq-signo { display: grid; place-items: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: var(--radio); background: var(--agua); color: var(--c-primario); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c-primario) 25%, transparent); font-family: var(--fuente-texto); font-size: 1.5rem; font-weight: 400; line-height: 1; transition: transform .2s ease, background-color .2s ease; }
  .faq[open] .faq-signo { transform: rotate(45deg); background: var(--c-primario); color: var(--sobre-primario); }
  .faq-respuesta { padding: 0 3.5rem 1.6rem 0; font-size: 1.05rem; opacity: .82; max-width: 46rem; }
</style>
